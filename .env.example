# Copy to .env for local development. .env is git-ignored — never commit real values.
ENV=local
LOG_LEVEL=INFO

# Anthropic API key for the qualification call (https://console.anthropic.com/).
ANTHROPIC_API_KEY=

# Local Postgres (see docker-compose.yml, added in P2.2).
DATABASE_URL=postgresql+psycopg://leadquali:leadquali@localhost:5432/leadquali

# Per-tenant ingest secrets for the public POST /leads endpoint (P2.4), as JSON:
#   {"<tenant_id>": {"api_key_sha256": "<sha256 hex of the API key>", "signing_secret": "..."}}
# Produce the hash with:
#   python -c "from leadquali.api.signing import hash_api_key; print(hash_api_key('<key>'))"
INGEST_CREDENTIALS=
