# Copy to .env for local development. .env is git-ignored — never commit real values.
ENV=local
LOG_LEVEL=INFO

# Anthropic API key for the qualification call (https://console.anthropic.com/).
ANTHROPIC_API_KEY=

# Local Postgres (see docker-compose.yml, added in P2.2).
DATABASE_URL=postgresql+psycopg://leadquali:leadquali@localhost:5432/leadquali
